# ===== FULL-CHAIN RAG E2E VALIDATION ONLY =====
# This is a non-secret overlay for a controlled smoke test. It is NOT a
# production recommendation and does not replace `.env`.
#
# The base `.env` must still provide working LLM credentials/model names,
# DATABASE_URL, REDIS_URL, and Milvus connectivity. Load this overlay into the
# backend process environment before startup so these values take precedence
# over `.env` without copying secrets into this file.
#
# This overlay intentionally uses isolated index authorities. After applying
# it, upload/reindex the fixture again; data indexed under another profile or
# collection is not valid evidence for this run.

# Enable external tracing for this controlled run. The base `.env` must supply
# a valid LANGSMITH_API_KEY and may override the endpoint when needed.
LANGSMITH_TRACING=true
LANGSMITH_PROJECT=superhermes-rag-full-chain-e2e
# Historical LangChain v2 enable flag. The installed runtime also recognizes
# LANGSMITH_TRACING, so this is an explicit compatibility alias, not a second
# tracer or an instruction to duplicate spans.
LANGCHAIN_TRACING_V2=true

# ===== Indexing and storage isolation =====
EMBEDDING_PROVIDER=local
EMBEDDING_MODEL=F:/models/bge-m3
EMBEDDING_DEVICE=auto
DENSE_EMBEDDING_DIM=1024
RAG_INDEX_PROFILE=v4_full
MILVUS_COLLECTION=embeddings_collection_v4_full_e2e
BM25_STATE_PATH=data/bm25_state_v4_full_e2e.json
EVAL_RETRIEVAL_TEXT_MODE=title_context_filename

# ===== Rerank and candidate lifecycle =====
RERANK_MODEL=F:/models/bge-reranker-v2-m3
RERANK_AVAILABLE_MODEL=F:/models/bge-reranker-v2-m3
RERANK_PROVIDER=local
RERANK_DEVICE=auto
RERANK_TORCH_DTYPE=float16
RERANK_CACHE_ENABLED=true
RERANK_CACHE_TTL_SECONDS=300
RERANK_PAIR_ENRICHMENT_ENABLED=true
RERANK_SCORE_FUSION_ENABLED=true
RERANK_FUSION_RERANK_WEIGHT=0.65
RERANK_FUSION_RRF_WEIGHT=0.20
RERANK_FUSION_SCOPE_WEIGHT=0.10
RERANK_FUSION_METADATA_WEIGHT=0.05
RERANK_INPUT_K_GPU=80
RERANK_INPUT_K_CPU=30
RERANK_CANDIDATE_POOL_SIZE=20
RAG_CANDIDATE_STRATEGY=layered
RAG_CANDIDATE_K=120
MILVUS_SEARCH_EF=160
MILVUS_SPARSE_DROP_RATIO=0.1
MILVUS_RRF_K=80

# ===== Structure, scope, and anchor consumers =====
AUTO_MERGE_ENABLED=true
AUTO_MERGE_THRESHOLD=2
LEAF_RETRIEVE_LEVEL=3
STRUCTURE_RERANK_ENABLED=true
STRUCTURE_RERANK_ROOT_WEIGHT=0.3
SAME_ROOT_CAP=3
STEP_CHAIN_CHECK_ENABLED=true
STEP_CHAIN_ADJACENT_LOOKBACK=2
DOC_SCOPE_MATCH_FILTER=0.85
DOC_SCOPE_MATCH_BOOST=0.60
DOC_SCOPE_MATCH_TRACE_MIN=0.30
DOC_SCOPE_GLOBAL_RESERVE_WEIGHT=0.15
DOC_SCOPE_FILENAME_BOOST_WEIGHT=0.15
HEADING_LEXICAL_ENABLED=true
HEADING_LEXICAL_WEIGHT=0.15
ENABLE_ANCHOR_GATE=true

# ===== Intent routing and comprehensive retrieval =====
QUERY_PLAN_ENABLED=true
RAG_INTENT_CLASSIFIER_ENABLED=true
# Keep the classifier model explicit: enabling the flag without either this
# value or FAST_MODEL silently degrades to the rules plan with confidence 0.
RAG_INTENT_CLASSIFIER_MODEL=qwen3.6-plus
# Five seconds favors reachability over latency acceptance.
RAG_INTENT_CLASSIFIER_TIMEOUT_SECONDS=5.0
RAG_COMPREHENSIVE_POSTPROCESS_PROFILE=quality_first_v1
RAG_COMPREHENSIVE_MAX_SUB_QUERIES=4

# ===== Confidence, delivery, and citations =====
CONFIDENCE_GATE_ENABLED=true
LOW_CONF_TOP_MARGIN=0.05
LOW_CONF_ROOT_SHARE=0.45
LOW_CONF_TOP_SCORE=0.20
RAG_UNIFIED_EXECUTION_ENABLED=true
RAG_CITATION_VERIFY_ENABLED=true

# ===== Multilevel fallback =====
# The deprecated master switch is still required by the current runtime. Its
# deprecation warning is expected; level-specific switches are also explicit.
RAG_FALLBACK_ENABLED=true
RAG_FALLBACK_LEVEL1_ENABLED=true
RAG_FALLBACK_LEVEL2_ENABLED=true
RAG_FALLBACK_COMPREHENSIVE_REWRITE_WINDOW=2
RAG_FALLBACK_WORKERS=4
RAG_FALLBACK_USE_FAST_MODEL=true
RAG_FALLBACK_CANDIDATE_ONLY=false
# Reachability-first budgets, not tuned defaults or production SLO evidence.
RAG_FALLBACK_TOTAL_BUDGET_MS=30000
RAG_FALLBACK_LEVEL1_BUDGET_MS=10000
RAG_FALLBACK_LEVEL2_BUDGET_MS=10000
# Level 2 expands 120 by 1.5x and must not be capped below the Level 0 pool.
RAG_FALLBACK_EXPANDED_CANDIDATE_K=180

# ===== Deliberately excluded alternate/reserved paths =====
# Deep mode is a separate orchestration mode, not another stage in the
# standard L0-L3 graph. Legacy RAG_MODE/RAG_FAST/RAG_PLAN flags are reserved
# compatibility inputs. Keep them off so this run has one interpretable path.
RAG_DEEP_SHADOW=false
RAG_DEEP_ACTIVE=false
RAG_MODE_SHADOW_ENABLED=false
RAG_MODE_ROUTING_ENABLED=false
RAG_FAST_ENABLED=false
RAG_PLAN_EXECUTION_ENABLED=false
