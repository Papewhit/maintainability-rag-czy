# RAG INTENT-ROUTING WORKFLOW VALIDATION ONLY.
# NOT A PRODUCTION RECOMMENDATION. Keep the repository/runtime defaults unchanged.
# Evaluate retrieval quality, cost, and fallback behavior before any production rollout.

# Build QueryPlan from the routed intent.
RAG_INTENT_CLASSIFIER_ENABLED=true
QUERY_PLAN_ENABLED=true

# Consume structured anchors during candidate reranking and confidence evaluation.
HEADING_LEXICAL_ENABLED=true
CONFIDENCE_GATE_ENABLED=true
ENABLE_ANCHOR_GATE=true

# Allow anchor mismatch and other confidence reasons to reach the existing precise fallback path.
RAG_FALLBACK_ENABLED=true
